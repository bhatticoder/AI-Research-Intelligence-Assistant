# ============================================
# ARIA - AI Research & Intelligence Assistant
# Environment Configuration
# ============================================

# --- Application ---
APP_NAME=ARIA
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://aria_user:aria_secret_2024@localhost:5432/aria
POSTGRES_PASSWORD=aria_secret_2024

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=aria_minio
MINIO_ROOT_PASSWORD=aria_minio_secret
MINIO_BUCKET=aria-documents
MINIO_USE_SSL=false

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Obsidian ---
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SYNC_INTERVAL=300

# --- News APIs ---
NEWS_API_KEY=
ARXIV_MAX_RESULTS=20

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
